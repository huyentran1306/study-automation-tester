{
  "name": "playforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply playforge-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply playforge-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@opennextjs/cloudflare": "1.19.4",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "next": "15.5.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sucrase": "3.35.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.15",
    "postcss": "8.5.9",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "wrangler": "4.85.0"
  }
}
